{
  "name": "zelseptik-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend-исходники сайта ЗЕЛСЕПТИК (HostCMS). Зеркало боевых путей: assets/css/core, templates/template1.",
  "scripts": {
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:js": "eslint templates/**/*.js",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:fix": "stylelint \"assets/css/**/*.css\" --fix && eslint templates/**/*.js --fix",
    "format": "prettier --write \"**/*.{css,js,json,md,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
